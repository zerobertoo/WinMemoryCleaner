<local:View x:Class="WinMemoryCleaner.MessageDialog"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:local="clr-namespace:WinMemoryCleaner"
            xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            DataContext="{Binding MessageViewModel, Source={StaticResource ViewModelLocator}}"
            ExtendsContentIntoTitleBar="True"
            FlowDirection="{Binding Path=(local:Localizer.Language).Direction}"
            FocusManager.FocusedElement="{Binding ElementName=RightButton}"
            Icon="/WinMemoryCleaner;component/Resources/Images/win-memory-cleaner.ico"
            ResizeMode="NoResize"
            SizeToContent="WidthAndHeight"
            Title="{x:Static local:Constants+App.Title}"
            WindowBackdropType="Mica"
            WindowStartupLocation="CenterScreen">
    <Grid MinWidth="320">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0"
                     Icon="/WinMemoryCleaner;component/Resources/Images/win-memory-cleaner.ico"
                     ShowMaximize="False"
                     ShowMinimize="False"
                     Title="{x:Static local:Constants+App.Title}" />
        <Grid Grid.Row="1" Margin="20, 10, 20, 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="{Binding Message}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="0, 20, 0, 0"
                        Orientation="Horizontal">
                <ui:Button Click="OnLeftButtonClick"
                           Content="{Binding LeftButton.Key}"
                           Margin="0, 0, 10, 0"
                           Visibility="{Binding LeftButton.Key, Converter={StaticResource NullToVisibilityConverter}}" />
                <ui:Button Appearance="Primary"
                           Click="OnRightButtonClick"
                           Content="{Binding RightButton.Key}"
                           Name="RightButton" />
            </StackPanel>
        </Grid>
    </Grid>
</local:View>
