<?xml version="1.0" encoding="UTF-8"?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:WinMemoryCleaner" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WinMemoryCleaner.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI: tema (Fluent) e estilos dos controles -->
                <!-- Dark é só o valor inicial; o ThemeManager aplica o tema salvo logo na inicialização -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:BrushToHexConverter x:Key="BrushToHexConverter" />
            <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <local:PercentageToAngleConverter x:Key="PercentageToAngleConverter" />
            <local:PercentageToWidthConverter x:Key="PercentageToWidthConverter" />
            <local:StringFormatConverter x:Key="StringFormatConverter" />
            <local:SumNumericConverter x:Key="SumNumericConverter" />
            <local:ViewModelLocator x:Key="ViewModelLocator" />
            <!-- Colors (substituídas em tempo de execução pelo ThemeManager) -->
            <SolidColorBrush x:Key="Accent" Color="#E30613" />
            <SolidColorBrush x:Key="MemoryBarIndicatorBackground" Color="#F4F2EE" />
            <SolidColorBrush x:Key="MemoryBarTrackBackground" Color="#6E6E69" />
            <SolidColorBrush x:Key="PrimaryBackground" Color="#141414" />
            <SolidColorBrush x:Key="PrimaryBorder" Color="#4A4A47" />
            <SolidColorBrush x:Key="SecondaryBackground" Color="#1E1E1D" />
            <SolidColorBrush x:Key="SecondaryBorder" Color="#8A8A85" />
            <SolidColorBrush x:Key="SecondaryDisabled" Color="#9A9A94" />
            <SolidColorBrush x:Key="SecondaryForeground" Color="#F4F2EE" />
            <!-- Font (o tamanho é alterado pelo MainViewModel) -->
            <FontFamily x:Key="FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <System:Double x:Key="FontSize">14</System:Double>
            <FontWeight x:Key="FontWeight">Normal</FontWeight>
            <!-- Barra de memória reutilizada nas leituras de memória física e virtual -->
            <ControlTemplate x:Key="MemoryBarTemplate" TargetType="{x:Type ProgressBar}">
                <Grid VerticalAlignment="Stretch">
                    <Border Background="{DynamicResource MemoryBarTrackBackground}" Name="PART_Track" VerticalAlignment="Stretch" />
                    <Border Background="{DynamicResource MemoryBarIndicatorBackground}" HorizontalAlignment="Left" Name="PART_Indicator" VerticalAlignment="Stretch" />
                </Grid>
            </ControlTemplate>
            <!-- Item de cor (quadrado + hexadecimal) dos seletores de cor do ícone da bandeja -->
            <DataTemplate x:Key="ColorSwatchItemTemplate">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Fill="{Binding}" Height="16" RadiusX="3" RadiusY="3" VerticalAlignment="Center" Width="16" />
                    <TextBlock Margin="4, 0, 0, 0" Text="{Binding Converter={StaticResource BrushToHexConverter}}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
            <!-- Estado de erro: vermelho de sinal, nunca a cor de desabilitado -->
            <Style x:Key="InlineErrorTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            </Style>
            <!-- As janelas herdam de View (FluentWindow); sem este estilo o tema Fluent não é aplicado -->
            <Style TargetType="{x:Type local:View}" BasedOn="{StaticResource {x:Type ui:FluentWindow}}" />
            <!-- Seção em cartão: fundo e contorno do tema Fluent, cabeçalho em destaque -->
            <Style TargetType="{x:Type GroupBox}">
                <Setter Property="Padding" Value="0, 8, 0, 0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupBox}">
                            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14, 10, 14, 12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Grid.Row="0" Text="{TemplateBinding Header}" />
                                    <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
